# Never commit .env. Enter the target IDs here; bootstrap asks for the Meta token.
META_SYSTEM_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=
FACEBOOK_GRAPH_API_VERSION=v26.0
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_LOGIN_TYPE=facebook

# Mastodon uses the same .env lookup; enter its independently issued token.
MASTODON_BASE_URL=https://norden.social
MASTODON_ACCESS_TOKEN=
