# Backend and HTTP client. Copy to .env and set a strong shared API token.
DATABASE_URL=postgresql+psycopg://localhost/kulturbytes_social
KULTURBYTES_SOCIAL_API_URL=http://127.0.0.1:8000
KULTURBYTES_SOCIAL_API_TOKEN=

# Server-side Meta credentials and targets. Never send these in API requests.
META_SYSTEM_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=
FACEBOOK_GRAPH_API_VERSION=v26.0
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_LOGIN_TYPE=facebook

# Server-side Mastodon configuration.
MASTODON_BASE_URL=https://norden.social
MASTODON_ACCESS_TOKEN=
